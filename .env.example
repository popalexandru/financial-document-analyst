APP_NAME="Financial Document Analyst"
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATA_DIR=data/documents
MAX_UPLOAD_SIZE_MB=10
CHROMA_DIR=data/chroma
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=256
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GENERATION_PROVIDER=local
OPENAI_GENERATION_MODEL=gpt-5.4-mini
RAG_TOP_K=5
RAG_MINIMUM_SCORE=0.05

# Added in later milestones; never commit the real value.
OPENAI_API_KEY=
